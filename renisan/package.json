{
  "name": "renisan",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Multilingual eligibility checker & scholarship directory for Iraqi & Kurdish Grade-12 students",
  "scripts": {
    "dev": "vite",
    "build": "node tests/verify.js && tsc && vite build && node tests/check-build.js",
    "preview": "vite preview",
    "test": "node tests/verify.js",
    "test:build": "node tests/check-build.js",
    "typecheck": "tsc --noEmit",
    "check": "tsc && node tests/verify.js",
    "import:federal": "python3 scripts/import-federal-cutoffs.py",
    "opps:watch": "node --max-http-header-size=65536 scripts/opportunities/watch.ts",
    "opps:harvest": "node --max-http-header-size=65536 scripts/opportunities/harvest.ts",
    "opps:discover": "node scripts/opportunities/discover.ts",
    "opps:review": "node scripts/opportunities/review.ts",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json"
  },
  "dependencies": {
    "preact": "^10.25.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@preact/preset-vite": "^2.9.0",
    "@types/node": "^22.20.5",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  },
  "engines": {
    "node": ">=22.18"
  }
}
