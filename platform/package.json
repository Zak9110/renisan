{
  "name": "renisan-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/db/seed.ts",
    "db:import-scholarships": "tsx --env-file-if-exists=.env.local src/db/import-scholarships.ts",
    "db:import-cutoffs": "tsx --env-file-if-exists=.env.local src/db/import-cutoffs.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "next-intl": "^4.15.1",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
