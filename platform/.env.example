# Copy to .env.local. Never commit real values. Validated with zod at boot (src/lib/env.ts).

# local | test | preview | production. Strict secret/provider checks apply only to production.
APP_ENV=local

# Local dev without installing Postgres: pglite://./.pglite (file) or pglite://memory.
# Preview/production: postgres://user:password@host:5432/renisan
DATABASE_URL=pglite://./.pglite
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-32-bytes-minimum-xxxxxxxx
CRON_SECRET=change-me-cron-secret

# SMS (provider chosen by SMS_PROVIDER: console | otpiq). console is refused in production.
SMS_PROVIDER=console
OTPIQ_API_KEY=

# Email OTP
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.org
EMAIL_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me
TELEGRAM_CHATID_ENCRYPTION_KEY=change-me-32-bytes

# Payments (Phase 2; provider: manual | zaincash | fastpay)
PAYMENT_PROVIDER=manual
ZAINCASH_MERCHANT_ID=
ZAINCASH_SECRET=
FASTPAY_STORE_ID=
FASTPAY_STORE_PASSWORD=

# File storage for private verification documents (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Analytics (privacy-respecting)
ANALYTICS_DOMAIN=
